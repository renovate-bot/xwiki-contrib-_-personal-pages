<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xwiki.contrib</groupId>
    <artifactId>parent-platform</artifactId>
    <version>16.10.17</version>
  </parent>
  <groupId>org.xwiki.contrib.personalpages</groupId>
  <artifactId>application-personal-pages</artifactId>
  <version>1.2-SNAPSHOT</version>
  <packaging>xar</packaging>
  <name>Personal Pages Application</name>
  <description>Personal pages for every user, as proposed in the XWiki Personal Pages design. Users create their own pages with one click; administrators choose where they are created and who can read them.</description>
  <scm>
    <connection>scm:git:git://github.com/xwiki-contrib/personal-pages.git</connection>
    <developerConnection>scm:git:git@github.com:xwiki-contrib/personal-pages.git</developerConnection>
    <url>https://github.com/xwiki-contrib/personal-pages/tree/master</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>jira</system>
    <url>https://jira.xwiki.org/browse/PERSONALPG</url>
  </issueManagement>
  <developers>
    <developer>
      <id>KiloNiner</id>
      <name>Karsten Sandmand</name>
    </developer>
  </developers>
  <properties>
    <xwiki.issueManagement.jira.id>PERSONALPG</xwiki.issueManagement.jira.id>
    <xwiki.extension.name>Personal Pages</xwiki.extension.name>
    <xwiki.extension.category>application</xwiki.extension.category>
  </properties>
  <dependencies>
    <!-- {{children/}} and {{documentTree/}} macros used by the hub and by each personal page -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-index-tree-macro</artifactId>
      <version>${platform.version}</version>
      <type>xar</type>
      <scope>runtime</scope>
    </dependency>
    <!-- "All personal pages" table on the hub -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-livedata-macro</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-livedata-livetable</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- "My pages" drawer entry and the user profile section -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-uiextension-api</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- PersonalPages.Code.Translations -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-localization-source-wiki</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Form token check on "Create my personal page" -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-csrf</artifactId>
      <version>${platform.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.xwiki.commons</groupId>
        <artifactId>xwiki-commons-tool-xar-plugin</artifactId>
        <configuration>
          <!-- The hub is a visible, translatable content page; everything else is technical. -->
          <contentPages>
            <contentPage>.*/PersonalPages/WebHome\.xml</contentPage>
          </contentPages>
          <entries>
            <!-- The settings: installed with the defaults, never touched by upgrades so administrators keep theirs. -->
            <entry>
              <document>PersonalPages.Code.Configuration</document>
              <type>configuration</type>
            </entry>
          </entries>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
